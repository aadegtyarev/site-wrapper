{
  "manifest_version": 2,
  "name": "Site Wrapper",
  "version": "0.1.0",
  "description": "Firefox window and settings for Site Wrapper",
  "browser_specific_settings": {
    "gecko": {
      "id": "site-wrapper@aadegtyarev.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity"]
      }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-settings": {
      "suggested_key": { "default": "Ctrl+Alt+S" },
      "description": "Open Site Wrapper settings"
    }
  }
}

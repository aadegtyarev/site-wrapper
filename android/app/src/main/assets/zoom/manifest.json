{
  "manifest_version": 2,
  "name": "Site Wrapper zoom",
  "version": "0.1.0",
  "browser_specific_settings": { "gecko": { "id": "android-zoom@site-wrapper" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["zoom.js"], "run_at": "document_start", "all_frames": false }]
}
